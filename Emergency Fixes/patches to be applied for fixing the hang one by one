var (
	notifCacheMux      sync.RWMutex
	lastNotifFileMtime = make(map[string]time.Time)
	cachedRawSender    string
	cachedRawMsg       string
	cachedRawType      string
	cachedLocalID      string
)

func getLatestNotificationMessage(activeHost string) (string, string, string) {
	// Deduplicate candidates: /tmp/cross_notifications.json is os.TempDir() on Linux
	candidates := []string{
		filepath.Join(tunnel.GetUniversalBaseDir(), "notifications.json"),
		"/tmp/cross_notifications.json",
	}

	sudoUser := os.Getenv("SUDO_USER")
	if sudoUser != "" && sudoUser != "root" {
		userPath := filepath.Join("/home", sudoUser, ".cross-ssh", "notifications.json")
		if userPath != candidates[0] {
			candidates = append(candidates, userPath)
		}
	}

	if cachedLocalID == "" {
		cachedLocalID = tunnel.GetLocalNodeIdentity()
	}

	notifCacheMux.Lock()
	defer notifCacheMux.Unlock()

	// Check if any candidate has been modified since last check
	anyFileChanged := false
	for _, p := range candidates {
		info, err := os.Stat(p)
		if err != nil || info.Size() == 0 {
			continue
		}
		if !info.ModTime().Equal(lastNotifFileMtime[p]) {
			anyFileChanged = true
			lastNotifFileMtime[p] = info.ModTime()
		}
	}

	// Fast path: No disk modifications detected, return cached notification state instantly
	if !anyFileChanged && cachedRawMsg != "" {
		return cachedRawSender, cachedRawMsg, cachedRawType
	}

	for _, p := range candidates {
		data, err := os.ReadFile(p)
		if err != nil || len(data) == 0 {
			continue
		}
		lines := strings.Split(strings.TrimSpace(string(data)), "\n")
		for i := len(lines) - 1; i >= 0; i-- {
			l := strings.TrimSpace(lines[i])
			if l == "" {
				continue
			}

			item, ok := parseNotificationLine(l)
			if ok && !item.IsRead {
				sender := item.SenderTag
				if sender == "" {
					sender = item.SenderIP
				}

				if sender == cachedLocalID || item.SenderIP == cachedLocalID || sender == "YOU" {
					continue
				}

				cachedRawSender = sender
				cachedRawMsg = item.Message
				cachedRawType = item.Type
				return cachedRawSender, cachedRawMsg, cachedRawType
			}
		}
	}

	cachedRawSender, cachedRawMsg, cachedRawType = "", "", ""
	return "", "", ""
}



